# .env.example — Configuration Environment Variables

# App URL Configuration
VITE_APP_URL=https://artavel.co.id

# Product Demo URLs
# Use NEXT_PUBLIC_* for browser-visible demo links.
NEXT_PUBLIC_OTOSCHOOL_DEMO_URL=
NEXT_PUBLIC_OTOPOS_DEMO_URL=
OTOSCHOOL_DEMO_URL=
OTOPOS_DEMO_URL=

# Email Service Endpoint (Optional Abstraction)
# VITE_EMAIL_SERVICE_ENDPOINT=https://api.artavel.co.id/v1/contact

# Analytics (Optional / Consent Required)
# VITE_ENABLE_ANALYTICS=false
